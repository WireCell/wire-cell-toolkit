def glob_epochs(w):
    from glob import glob
    # epoch_dirs = list(set(glob("epoch_**/")) - set(glob("epoch_benchmarks_**/")))
    cpts = glob(f'{config["cpt_dir"]}/checkpoint*.pt')
    #return [f'epoch_{d}/all_eff_pur_{p}plane-xvu.npz' for d in range(len(cpts)) for p in ('u', 'v', 'w')]
    #ASSUMES EPOCH NUMBER IS LAST IN STRING AND AFTER _
    return [f'epoch_{cpt.replace(".pt","").split('_')[-1]}/all_eff_pur_{p}plane-xvu.npz' for cpt in cpts for p in ('u', 'v', 'w')]

