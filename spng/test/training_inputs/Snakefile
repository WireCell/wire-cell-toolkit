def get_plot_input_by_plane(w):
    if w.plane == 'u':
        angles = high_end_xzu_xzv_deg_uplane
    elif w.plane == 'v':
        angles = high_end_xzu_xzv_deg_vplane
    elif w.plane == 'w':
        angles = high_end_xzw_xzu_deg_wplane
    res = [f'line-display-{w.plane}plane-t1_{t1}-t2_{t2}.pickle' for t1, t2 in angles]
    return res

def xvu_get_plot_input_by_plane(w):
    return ['xvu-' + r for r in get_plot_input_by_plane(w)]

