# Run an a reco/true h5 pair through a model
#
plane_to_view = {'u':0, 'v':1, 'w':2}
config.setdefault('dnnapp', 'dnnroi_custom')
config.setdefault('model', '')
config.setdefault('cfg', '')
rule run_one:
    input:
        rec=lambda w : ('linedepos-pdhd-{plane}plane-t1_{t1}-t2_{t2}-g4-rec-' + f'{plane_to_view[w.plane]}.h5'),
        tru=lambda w : ('linedepos-pdhd-{plane}plane-t1_{t1}-t2_{t2}-g4-tru-' + f'{plane_to_view[w.plane]}.h5'),
    benchmark:
        '<benchmarks>/run_one_{t1}_{t2}_{plane}'
    output:
        '<results>/test_line_{plane}plane_t1-{t1}-t2-{t2}.pt'
    params:
        device=config['device'],
        model=config['model'],
        app=config['dnnapp'],
        cfg=config['cfg'],
    resources:
        gpu = 1 if config['device'] == 'gpu' else 0
    shell: """
    wcpy dnn run_one \
    {input.rec} {input.tru} \
    --app {params.app} \
    -l {params.model} \
    -c {params.cfg} \
    --manual-sigmoid \
    -d {params.device} \
    -o {output}
    """

config.setdefault('cpt_dir', '.')
config.setdefault('proc', '0')
config.setdefault('cluster', '0')
use rule run_one as run_one_epoch with:
    pathvars:
      results="epoch_{epoch}",
      benchmarks="epoch_benchmarks_{epoch}"
    params:
      model=f'{config["cpt_dir"]}/checkpoint_{config["proc"]}_{config["cluster"]}_{{epoch}}.pt'

use rule run_one as run_one_xvu with:
