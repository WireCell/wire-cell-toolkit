def get_input_by_plane(wildcards):
    angles = get_angles_by_plane(wildcards.plane)
    return [
        f'<results>/test_line_{wildcards.plane}plane_t1-{t1}-t2-{t2}.pt' for t1,t2 in angles
    ]
def get_input_by_plane_xvu(wildcards):
    angles = get_angles_by_plane(wildcards.plane)
    return [
        f'<results>/xvu-test_line_{wildcards.plane}plane_t1-{t1}-t2-{t2}.pt' for t1,t2 in angles
    ]

rule pixel_eff_pur:
    params:
        # threshold=0.5,
        chan_range=(0, 800),
    run:
        import torch
        import numpy as np
        t = torch.load(input[0])
        labels = t['labels'][0].detach().cpu()
        y = t['y'][0].detach().cpu()
        this_range=params.chan_range
        real_pixels = torch.where(labels[this_range[0]:this_range[1]] > 0)
        threshold = float(wildcards.threshold)
        eff = (y[this_range[0]:this_range[1]][real_pixels] > threshold).sum()/labels[this_range[0]:this_range[1]].sum()
        pur = (y[this_range[0]:this_range[1]][real_pixels] > threshold).sum()/(y[this_range[0]:this_range[1]] > threshold).sum()

        np.savez(output[0], eff=eff, pur=pur)

use rule pixel_eff_pur as pixel_eff_pur_xvu_line with:
    input:
        '<results>/xvu-test_line_{plane}plane_t1-{t1}-t2-{t2}.pt'
    output:
        '<results>/xvu-test_line_{plane}plane_t1-{t1}-t2-{t2}-eff-pur-t{threshold}.npz'
    # params:
    #     threshold=wildcards.threshold

rule eff_pur_scan:
    input:
        expand('<results>/xvu-test_line_uplane_t1-75-t2-75-eff-pur-t{threshold}.npz',
               threshold=np.arange(0.05,1.0,0.05))
    output:
        '<results>/test_scan.npz'
    run:
        import numpy as np
        effs = []
        purs = []
        for inp in input:
            t = np.load(inp)
            effs.append(t['eff'])
            purs.append(t['pur'])
        np.savez(output[0], effs=effs, purs=purs)


