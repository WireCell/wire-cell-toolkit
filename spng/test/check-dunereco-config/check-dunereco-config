def cmd_list(args):
    print("Comparisons (use with --comparison / -c):")
    for name in sorted(COMPARISONS):
        c = COMPARISONS[name]
        spng_ok = SPNG.get(c["spng"]) is not None
        off_ok = OFFICIAL.get(c["official"]) is not None
        status = "ok" if (spng_ok and off_ok) else "UNAVAILABLE"
        print("  %-14s [%s]  SPNG %s vs official %s"
              % (name, status, c["spng"], c["official"]))
        print("      %s" % c["desc"])
        if not spng_ok:
            print("      (SPNG has no %r config)" % c["spng"])
        elif SPNG[c["spng"]].get("note"):
            print("      note: %s" % SPNG[c["spng"]]["note"])
    print("\nOfficial detectors : %s" % ", ".join(sorted(OFFICIAL)))
    print("SPNG detectors     : %s"
          % ", ".join("%s%s" % (d, "" if SPNG[d] else " (missing)") for d in sorted(SPNG)))
    print("reference : %s" % (args.reference or default_reference()))
    print("wcsonnet  : %s" % (args.wcsonnet or default_wcsonnet()))


def cmd_diff(args):
    result = compare(args.comparison, args.wcsonnet or default_wcsonnet(),
                     Path(args.reference or default_reference()), keep=args.keep)
    if args.json:
        # tuples -> serialisable
        result_ser = dict(result)
        result_ser["filters_changed"] = [
            {"name": n, **d} for n, d in result["filters_changed"]
        ]
        result_ser["osp"] = dict(result["osp"])
        result_ser["osp"]["changed"] = [
            {"key": k, "official": o, "spng": s} for k, o, s in result["osp"]["changed"]
        ]
        print(json.dumps(result_ser, indent=2, sort_keys=True))
        return 0
    text, n = report_text(result, color=sys.stdout.isatty() and not args.no_color,
                          show_all=args.all_diffs)
    print(text)
    return 1 if n else 0


def cmd_emit_prompt(args):
    doc = emit_prompt(args.comparison, args.wcsonnet or default_wcsonnet(),
                      Path(args.reference or default_reference()), keep=args.keep)
    if args.output:
        Path(args.output).write_text(doc)
        sys.stderr.write("wrote %s (%d bytes)\n" % (args.output, len(doc)))
    else:
        print(doc)
    return 0


def cmd_extract(args):
    cmp_, off_spec, spng_jobs = resolve_comparison(args.comparison)
    wc = args.wcsonnet or default_wcsonnet()
    ref = Path(args.reference or default_reference())
    if args.which == "official":
        g = eval_official(off_spec, wc, ref, keep=args.keep)
        osp, filt = extract_osp(g)
        print(json.dumps({"osp": osp, "filters": filt}, indent=2, sort_keys=True))
    elif args.which == "spng-osp":
        g = eval_spng(spng_jobs["osp"], wc)
        osp, filt = extract_osp(g)
        print(json.dumps({"osp": osp, "filters": filt}, indent=2, sort_keys=True))
    elif args.which == "spng-tdm":
        g = eval_spng(spng_jobs["tdm"], wc)
        print(json.dumps(extract_tdm(g), indent=2, sort_keys=True))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="check-dunereco-config",
        description="Detect SPNG config drift from official dunereco OSP config.",
    )
    p.add_argument("--reference", help="dunereco DUNEWireCell dir (default <repo>/reference/...)")
    p.add_argument("--wcsonnet", help="wcsonnet binary (default <repo>/install/bin/wcsonnet)")
    p.add_argument("--keep", action="store_true", help="keep generated temp fixtures")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_comparison_arg(parser):
        parser.add_argument(
            "-c", "--comparison", "--detector", dest="comparison", default="pdhd",
            help="comparison name (see `list`); --detector is an alias")

    sp = sub.add_parser("list", help="list comparisons, detectors and paths")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("diff", help="mechanistic like-for-like OSP diff (axis A)")
    add_comparison_arg(sp)
    sp.add_argument("--json", action="store_true", help="machine-readable output")
    sp.add_argument("--all-diffs", action="store_true",
                    help="also show diffs marked as expected/intentional")
    sp.add_argument("--no-color", action="store_true")
    sp.set_defaults(func=cmd_diff)

    sp = sub.add_parser("emit-prompt", help="write semantic-comparison prompt (axis B)")
    add_comparison_arg(sp)
    sp.add_argument("-o", "--output", help="write to file instead of stdout")
    sp.set_defaults(func=cmd_emit_prompt)

    sp = sub.add_parser("extract", help="dump a normalised extract (debug)")
    sp.add_argument("which", choices=["official", "spng-osp", "spng-tdm"])
    add_comparison_arg(sp)
    sp.set_defaults(func=cmd_extract)

    args = p.parse_args(argv)
    try:
        return args.func(args)
    except EvalError as exc:
        sys.stderr.write("ERROR: %s\n" % exc)
        return 2


if __name__ == "__main__":
    sys.exit(main())
