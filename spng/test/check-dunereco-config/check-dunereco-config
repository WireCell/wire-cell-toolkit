#!/usr/bin/env python3
"""check-dunereco-config -- detect SPNG signal-processing config drift from the
"official" dunereco OSP configuration and offer compliant changes.

Background
----------
The SPNG ("signal processing, next generation") configuration under
toolkit/spng/cfg/spng was derived, largely by LLM, from the "official" dunereco
configuration that drives WCT's original OmnibusSigProc (OSP).  We want SPNG
evaluations to stay faithful to that official configuration.  The authoritative
official source is the dunereco reference tree, by default:

    <repo>/reference/dunereco/dunereco/DUNEWireCell/{pdhd,pdsp,protodunevd}/

This tool provides two complementary comparisons (see README.org):

  A. MECHANISTIC  (this script, `diff`):
     A filtered, like-for-like JSON diff of the *evaluated* configuration.
     Both the official config and the SPNG "mirror OSP" config
     (spng/detconfs/<det>/sp.jsonnet + sp-filters.jsonnet, driven through
     spng/adc-to-osp.jsonnet) produce an `OmnibusSigProc` node plus
     `HfFilter`/`LfFilter` filter components.  We normalise away superfluous
     differences (instance names, per-anode tag suffixes, node-handle instance
     names) and report genuine parameter/filter drift, with suggested changes.

  B. SEMANTIC  (this script, `emit-prompt`; plus a companion skill):
     The SPNG-native "tensor data model" (TDM) config expresses the same physics
     in a different idiom (SPNGFilterKernel / SPNGResponseKernel / ...), so a
     purely syntactic diff cannot map it.  `emit-prompt` writes a self-contained
     prompt bundling the official extract, the SPNG-native TDM extract, and a
     mapping rubric, for an LLM (or the check-dunereco-config skill) to judge.

Both configs are Jsonnet.  Evaluation needs top-level args (TLAs) and/or
ext-vars; the per-detector case registry below records exactly which.

Usage
-----
    check-dunereco-config list
    check-dunereco-config diff   [--detector pdhd] [--json] [--all-diffs]
    check-dunereco-config emit-prompt [--detector pdhd] [-o report.md]
    check-dunereco-config extract {official,spng-osp,spng-tdm} [--detector pdhd]

Options of note:
    --reference DIR   dunereco DUNEWireCell dir (default <repo>/reference/...)
    --wcsonnet PATH   the wcsonnet binary (default <repo>/install/bin/wcsonnet)
    --keep            keep generated temp fixtures (for debugging)
"""

import argparse
import json
import math
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

# --------------------------------------------------------------------------
# Paths
# --------------------------------------------------------------------------

SCRIPT = Path(__file__).resolve()
SCRIPT_DIR = SCRIPT.parent
# .../toolkit/spng/test/check-dunereco-config -> toolkit is parents[2], repo [3]
TOOLKIT_DIR = SCRIPT_DIR.parents[2]
REPO_ROOT = SCRIPT_DIR.parents[3]


def default_reference():
    return REPO_ROOT / "reference" / "dunereco" / "dunereco" / "DUNEWireCell"


def default_wcsonnet():
    cand = REPO_ROOT / "install" / "bin" / "wcsonnet"
    return str(cand) if cand.exists() else "wcsonnet"


def wirecell_path():
    """WIRECELL_PATH covering the standard toolkit trees plus SPNG cfg.

    Order matters: toolkit/cfg is kept first so shared files (wirecell.jsonnet,
    pgraph.jsonnet, pgrapher/...) are never shadowed.  The dunereco reference
    tree is deliberately NOT placed on the path -- the official fixture imports
    its sp.jsonnet by absolute path (see fixtures/official-*.jsonnet) precisely
    to avoid such shadowing.  Any pre-existing WIRECELL_PATH is appended.
    """
    parts = [
        str(TOOLKIT_DIR / "cfg"),
        str(TOOLKIT_DIR / "data"),
        str(TOOLKIT_DIR / "spng" / "cfg"),
    ]
    existing = os.environ.get("WIRECELL_PATH", "")
    if existing:
        parts.append(existing)
    return ":".join(parts)


# --------------------------------------------------------------------------
# Registry.  Adding coverage should be data, not code.
#
# The registry is split into three parts so that a SPNG config for one detector
# can be compared against the official config of a *different* detector (a
# "cross comparison").  This matters for PDHD: the real PDHD detector has a
# partly-broken first APA with a non-standard field response, and the official
# PDHD config bakes in bad-APA tunings (plane swaps, per-APA Wiener filters).
# SPNG idealises PDHD as all-good.  The *nominal* design reference for an
# all-good PDHD is therefore official PDSP (same design, 6 good APAs), not
# official PDHD -- hence the "pdhd-x-pdsp" comparison below.
#
#   OFFICIAL[det] : how to instantiate the official OSP node
#     fixture  -- template under fixtures/ with @REFERENCE@/@ANODE@ placeholders
#     anode    -- APA/anode index (match the SPNG tpcid used on the SPNG side)
#     extvars  -- ext-vars the official Jsonnet requires (e.g. elecGain)
#
#   SPNG[det] : the SPNG jobs (None entry => SPNG has no config for that det)
#     osp      -- {jsonnet, tlas, extvars} "mirror OSP" job (axis A)
#     tdm      -- {jsonnet, tlas, extvars} SPNG-native TDM job (axis B)
#     note     -- optional caveat surfaced to the user
#
#   COMPARISONS[name] : a named pairing
#     spng      -- SPNG detector key (into SPNG)
#     official  -- official detector key (into OFFICIAL)
#     desc      -- one-line description
#     expected_deltas -- optional {param: reason} OmnibusSigProc keys whose
#        difference is a known intentional adaptation (kept small; anything not
#        listed is reported as DRIFT for human/LLM judgement)
# --------------------------------------------------------------------------

OFFICIAL = {
    "pdhd": {"fixture": "fixtures/official-pdhd.jsonnet", "anode": 0,
             "extvars": {"elecGain": "14.0"}},
    "pdsp": {"fixture": "fixtures/official-pdsp.jsonnet", "anode": 0,
             "extvars": {"elecGain": "14.0"}},
    "pdvd": {"fixture": "fixtures/official-protodunevd.jsonnet", "anode": 0,
             "extvars": {"elecGain": "14.0"}},
}


def _spng_jobs(detname, tpcid="0"):
    # NB: run_dnnroi is left at its Jsonnet default (true); passing it as a
    # string TLA would fail its boolean test.  Extra DNNROI nodes do not affect
    # OmnibusSigProc/filter extraction.  A dummy input/model filename is fine --
    # nothing is read at evaluation time.
    return {
        "osp": {
            "jsonnet": "spng/adc-to-osp.jsonnet",
            "tlas": {"input": "dummy.npz", "detname": detname, "tpcid": tpcid},
            "extvars": {},
        },
        "tdm": {
            "jsonnet": "spng/adc-to-spng.jsonnet",
            "tlas": {"input": "dummy.npz", "model_file": "dummy.ts",
                     "detname": detname, "tpcid": tpcid},
            "extvars": {},
        },
    }


SPNG = {
    "pdhd": dict(_spng_jobs("pdhd")),
    "pdvd": dict(_spng_jobs("pdvd"),
                 note="SPNG pdvd currently fails to evaluate ('Field does not "
                      "exist: tpc'); its detconfs/pdvd.jsonnet is incomplete "
                      "relative to the adc-to-osp/adc-to-spng jobs."),
    # No SPNG PDSP: there is no toolkit/spng/cfg/spng/detconfs/pdsp.jsonnet.
    "pdsp": None,
}


COMPARISONS = {
    "pdhd": {
        "spng": "pdhd", "official": "pdhd",
        "desc": "SPNG PDHD vs official PDHD (official PDHD carries bad-APA1 "
                "tunings; expect confounding drift -- see pdhd-x-pdsp)",
        "expected_deltas": {},
    },
    "pdhd-x-pdsp": {
        "spng": "pdhd", "official": "pdsp",
        "desc": "SPNG PDHD vs official PDSP (nominal all-good design; the "
                "faithful reference for an idealised SPNG PDHD)",
        "expected_deltas": {},
    },
    "pdsp": {
        "spng": "pdsp", "official": "pdsp",
        "desc": "SPNG PDSP vs official PDSP (SPNG has no PDSP config yet)",
        "expected_deltas": {},
    },
    "pdvd": {
        "spng": "pdvd", "official": "pdvd",
        "desc": "SPNG PDVD vs official protodunevd",
        "expected_deltas": {},
    },
}

# --------------------------------------------------------------------------
# Normalisation
# --------------------------------------------------------------------------

# OmnibusSigProc data keys whose value is a single "Type:instance" node handle.
# Instance names differ between the official and SPNG graphs for no meaningful
# reason, so we compare only the *type* token (and keep "" as-is, since an
# empty handle -- e.g. per_chan_resp:"" -- is a meaningful "not wired").
NODE_HANDLE_KEYS = {"anode", "dft", "field_response", "elecresponse", "per_chan_resp"}

# Keys whose value is a per-anode frame tag like "wiener0"/"gauss3"; the trailing
# digit is the anode ident (instance identity), which we strip.
TAG_KEY_RE = re.compile(r".*_tag$")
TRAILING_DIGITS_RE = re.compile(r"\d+$")

FLOAT_REL_TOL = 1e-9


def norm_handle(val):
    if isinstance(val, str):
        if val == "":
            return ""
        return val.split(":", 1)[0]
    return val


def strip_tag_suffix(val):
    if isinstance(val, str):
        return TRAILING_DIGITS_RE.sub("", val)
    return val


def normalize_osp_data(data):
    """Return a normalised copy of an OmnibusSigProc data block for comparison."""
    out = {}
    for key, val in data.items():
        if key in NODE_HANDLE_KEYS:
            out[key] = norm_handle(val)
        elif TAG_KEY_RE.match(key):
            out[key] = strip_tag_suffix(val)
        else:
            out[key] = val
    return out


def values_equal(a, b):
    """Deep equality with float tolerance."""
    if isinstance(a, bool) or isinstance(b, bool):
        # Keep JSON true/false distinct from 1/0 (Python conflates them).
        return isinstance(a, bool) and isinstance(b, bool) and a == b
    if isinstance(a, (int, float)) and isinstance(b, (int, float)):
        if a == b:
            return True
        return math.isclose(float(a), float(b), rel_tol=FLOAT_REL_TOL, abs_tol=0.0)
    if isinstance(a, list) and isinstance(b, list):
        return len(a) == len(b) and all(values_equal(x, y) for x, y in zip(a, b))
    if isinstance(a, dict) and isinstance(b, dict):
        if set(a) != set(b):
            return False
        return all(values_equal(a[k], b[k]) for k in a)
    return a == b


def fmt(val):
    return json.dumps(val)


# --------------------------------------------------------------------------
# Evaluation
# --------------------------------------------------------------------------


class EvalError(RuntimeError):
    pass


def run_wcsonnet(wcsonnet, jsonnet_file, tlas=None, extvars=None):
    cmd = [wcsonnet]
    for k, v in (extvars or {}).items():
        cmd += ["-V", "%s=%s" % (k, v)]
    for k, v in (tlas or {}).items():
        cmd += ["-A", "%s=%s" % (k, v)]
    cmd.append(str(jsonnet_file))
    env = dict(os.environ)
    env["WIRECELL_PATH"] = wirecell_path()
    proc = subprocess.run(cmd, capture_output=True, text=True, env=env)
    if proc.returncode != 0:
        raise EvalError(
            "wcsonnet failed (exit %d) for %s\ncmd: %s\nstderr:\n%s"
            % (proc.returncode, jsonnet_file, " ".join(cmd), proc.stderr[:2000])
        )
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise EvalError("could not parse wcsonnet JSON for %s: %s" % (jsonnet_file, exc))


def resolve_fixture(template_path, reference, anode, keep=False):
    """Substitute placeholders in a fixture template into a temp file, return path."""
    text = Path(template_path).read_text()
    text = text.replace("@REFERENCE@", str(reference)).replace("@ANODE@", str(anode))
    fd, path = tempfile.mkstemp(prefix="cdc-official-", suffix=".jsonnet")
    with os.fdopen(fd, "w") as fp:
        fp.write(text)
    if keep:
        sys.stderr.write("[keep] official fixture: %s\n" % path)
    return path


def eval_official(off_spec, wcsonnet, reference, keep=False):
    template = SCRIPT_DIR / off_spec["fixture"]
    if not template.exists():
        raise EvalError("missing official fixture template: %s" % template)
    resolved = resolve_fixture(template, reference, off_spec.get("anode", 0), keep=keep)
    try:
        return run_wcsonnet(wcsonnet, resolved, extvars=off_spec.get("extvars"))
    finally:
        if not keep:
            try:
                os.unlink(resolved)
            except OSError:
                pass


def eval_spng(spec, wcsonnet):
    return run_wcsonnet(
        wcsonnet, spec["jsonnet"], tlas=spec.get("tlas"), extvars=spec.get("extvars")
    )


# --------------------------------------------------------------------------
# Extraction
# --------------------------------------------------------------------------


def nodes_of_type(graph, typename):
    return [x for x in graph if isinstance(x, dict) and x.get("type") == typename]


def extract_osp(graph):
    """Return (osp_data_normalized, filters_by_name) from an OSP-idiom graph."""
    osps = nodes_of_type(graph, "OmnibusSigProc")
    if len(osps) != 1:
        raise EvalError("expected exactly 1 OmnibusSigProc, found %d" % len(osps))
    osp_data = normalize_osp_data(osps[0]["data"])
    filters = {}
    for tn in ("LfFilter", "HfFilter"):
        for node in nodes_of_type(graph, tn):
            filters[node["name"]] = {"type": tn, "data": node.get("data", {})}
    return osp_data, filters


def extract_tdm(graph):
    """Return SPNG-native TDM node summaries for the semantic (axis-B) prompt."""
    out = {}
    for tn in (
        "SPNGResponseKernel",
        "SPNGFilterKernel",
        "SPNGDeconKernel",
        "SPNGKernelConvolve",
    ):
        items = []
        for node in nodes_of_type(graph, tn):
            data = dict(node.get("data", {}))
            # Drop uniform runtime/context keys that carry no physics.
            for noise_key in ("device", "rng", "semaphore", "verbosity", "dft"):
                data.pop(noise_key, None)
            items.append({"name": node.get("name"), "data": data})
        if items:
            out[tn] = items
    return out


# --------------------------------------------------------------------------
# Diffing (axis A)
# --------------------------------------------------------------------------


def diff_data(off, spng):
    """Return dict with only_official, only_spng, changed (list of (k, off, spng))."""
    off_keys, spng_keys = set(off), set(spng)
    only_off = sorted(off_keys - spng_keys)
    only_spng = sorted(spng_keys - off_keys)
    changed = []
    for key in sorted(off_keys & spng_keys):
        if not values_equal(off[key], spng[key]):
            changed.append((key, off[key], spng[key]))
    return {"only_official": only_off, "only_spng": only_spng, "changed": changed}


def resolve_comparison(name):
    """Return (cmp_dict, off_spec, spng_jobs).  Validates availability."""
    if name not in COMPARISONS:
        sys.exit("unknown comparison %r; known: %s"
                 % (name, ", ".join(sorted(COMPARISONS))))
    cmp_ = COMPARISONS[name]
    off_det, spng_det = cmp_["official"], cmp_["spng"]
    off_spec = OFFICIAL.get(off_det)
    if off_spec is None:
        raise EvalError("no official config registered for %r" % off_det)
    spng_jobs = SPNG.get(spng_det)
    if spng_jobs is None:
        raise EvalError(
            "comparison %r is not buildable: SPNG has no %r configuration "
            "(there is no toolkit/spng/cfg/spng/detconfs/%s.jsonnet). "
            "The cross-comparison that IS available for an idealised SPNG is "
            "'pdhd-x-pdsp'." % (name, spng_det, spng_det)
        )
    return cmp_, off_spec, spng_jobs


def compare(name, wcsonnet, reference, keep=False):
    cmp_, off_spec, spng_jobs = resolve_comparison(name)
    off_graph = eval_official(off_spec, wcsonnet, reference, keep=keep)
    spng_graph = eval_spng(spng_jobs["osp"], wcsonnet)
    off_osp, off_filt = extract_osp(off_graph)
    spng_osp, spng_filt = extract_osp(spng_graph)

    osp_diff = diff_data(off_osp, spng_osp)

    # Filters: keyed by name (hard-coded, meaningful).  Report set + data diffs.
    fnames_off, fnames_spng = set(off_filt), set(spng_filt)
    filt_only_off = sorted(fnames_off - fnames_spng)
    filt_only_spng = sorted(fnames_spng - fnames_off)
    filt_changed = []
    for fname in sorted(fnames_off & fnames_spng):
        d = diff_data(off_filt[fname]["data"], spng_filt[fname]["data"])
        if d["only_official"] or d["only_spng"] or d["changed"]:
            filt_changed.append((fname, d))

    return {
        "comparison": name,
        "detector": name,  # kept for backward-compat with report header
        "desc": cmp_["desc"],
        "spng_det": cmp_["spng"],
        "official_det": cmp_["official"],
        "osp": osp_diff,
        "osp_official": off_osp,
        "osp_spng": spng_osp,
        "filters_only_official": filt_only_off,
        "filters_only_spng": filt_only_spng,
        "filters_changed": filt_changed,
        "expected_deltas": cmp_.get("expected_deltas", {}),
    }


# --------------------------------------------------------------------------
# Reporting
# --------------------------------------------------------------------------

BOLD = "\033[1m"
RED = "\033[31m"
YEL = "\033[33m"
GRN = "\033[32m"
DIM = "\033[2m"
RST = "\033[0m"


def _c(s, code, color):
    return "%s%s%s" % (code, s, color) if color else s


def report_text(result, color=True, show_all=False):
    def c(s, code):
        return "%s%s%s" % (code, s, RST) if color else s

    exp = result["expected_deltas"]
    lines = []
    lines.append(c("== check-dunereco-config: %s ==" % result["comparison"], BOLD))
    lines.append(c("   SPNG %s  vs  official %s"
                   % (result["spng_det"], result["official_det"]), DIM))
    lines.append(c("   %s" % result["desc"], DIM))
    lines.append("")

    n_findings = 0

    # ---- Filters ---------------------------------------------------------
    lines.append(c("-- Filter components (HfFilter/LfFilter) --", BOLD))
    fc = result["filters_changed"]
    if result["filters_only_official"]:
        n_findings += len(result["filters_only_official"])
        lines.append(
            c("  MISSING in SPNG: ", RED) + ", ".join(result["filters_only_official"])
        )
    if result["filters_only_spng"]:
        n_findings += len(result["filters_only_spng"])
        lines.append(
            c("  EXTRA in SPNG:   ", YEL) + ", ".join(result["filters_only_spng"])
        )
    if fc:
        for name, d in fc:
            for key, ov, sv in d["changed"]:
                n_findings += 1
                lines.append(
                    "  %s  %s.%s: official=%s  spng=%s"
                    % (c("DRIFT", RED), name, key, c(fmt(ov), GRN), c(fmt(sv), RED))
                )
                lines.append(
                    c("        fix: set SPNG %s.%s = %s" % (name, key, fmt(ov)), DIM)
                )
            for key in d["only_official"]:
                n_findings += 1
                lines.append(
                    "  %s  %s.%s present in official only"
                    % (c("DRIFT", RED), name, key)
                )
            for key in d["only_spng"]:
                n_findings += 1
                lines.append(
                    "  %s  %s.%s present in SPNG only" % (c("EXTRA", YEL), name, key)
                )
    if not (result["filters_only_official"] or result["filters_only_spng"] or fc):
        lines.append(c("  OK: all filters match", GRN))
    lines.append("")

    # ---- OmnibusSigProc --------------------------------------------------
    lines.append(c("-- OmnibusSigProc parameters --", BOLD))
    osp = result["osp"]
    if osp["changed"]:
        for key, ov, sv in osp["changed"]:
            tag = "expected" if key in exp else "DRIFT"
            if tag == "expected" and not show_all:
                continue
            n_findings += 1 if tag == "DRIFT" else 0
            code = YEL if tag == "expected" else RED
            lines.append(
                "  %s  %s: official=%s  spng=%s"
                % (c(tag, code), key, c(fmt(ov), GRN), c(fmt(sv), RED))
            )
            if tag == "expected":
                lines.append(c("        reason: %s" % exp[key], DIM))
            else:
                lines.append(c("        fix: set SPNG %s = %s" % (key, fmt(ov)), DIM))
    for key in osp["only_official"]:
        tag = "expected" if key in exp else "MISSING"
        if tag == "expected" and not show_all:
            continue
        n_findings += 1 if tag == "MISSING" else 0
        lines.append(
            "  %s  %s present in official only (=%s)"
            % (c(tag, RED if tag == "MISSING" else YEL), key, fmt(result["osp_official"][key]))
        )
        if tag == "MISSING":
            lines.append(
                c("        fix: add SPNG %s = %s" % (key, fmt(result["osp_official"][key])), DIM)
            )
    for key in osp["only_spng"]:
        tag = "expected" if key in exp else "EXTRA"
        if tag == "expected" and not show_all:
            continue
        lines.append(
            "  %s  %s present in SPNG only (=%s)"
            % (c(tag, YEL), key, fmt(result["osp_spng"][key]))
        )
    if not (osp["changed"] or osp["only_official"] or osp["only_spng"]):
        lines.append(c("  OK: all parameters match", GRN))
    lines.append("")

    verdict = (
        c("FAITHFUL: no drift detected", GRN)
        if n_findings == 0
        else c("DRIFT: %d finding(s) need attention" % n_findings, RED)
    )
    lines.append(c("== %s ==" % verdict, BOLD))
    return "\n".join(lines), n_findings


# --------------------------------------------------------------------------
# Prompt emission (axis B)
# --------------------------------------------------------------------------

MAPPING_RUBRIC = """\
## Mapping rubric: official OSP  <->  SPNG-native TDM

The official OmnibusSigProc is monolithic; SPNG decomposes it into kernels.
Use these correspondences when judging faithfulness:

| Physics / role                    | Official (OSP)                         | SPNG-native (TDM)                                   |
|-----------------------------------|----------------------------------------|-----------------------------------------------------|
| ADC<-voltage scaling              | OmnibusSigProc.ADC_mV (= 1/lsb_voltage)| SPNGResponseKernel.scale (= -1/lsb_voltage; sign=convolution polarity) |
| Field response                    | field_response (+ elecresponse)        | SPNGResponseKernel.field_response / elec_response   |
| ER integration window             | (implicit in elecresponse binning)     | SPNGResponseKernel.elec_duration, period            |
| Decon = filter / response         | internal to OmnibusSigProc             | SPNGDeconKernel(filter=SPNGFilterKernel, response=SPNGResponseKernel) |
| Gaussian smoothing filter         | HfFilter Gaus_wide (sigma, power)       | time-filter SPNGFilterKernel, kind=lowpass (scale~sigma, power) |
| Wiener tight/wide filters         | HfFilter Wiener_tight_* / Wiener_wide_* | time-filter SPNGFilterKernel(s) feeding wiener/dnnroi convolutions |
| Low-freq ROI filters              | LfFilter ROI_loose/tight/tighter_lf (tau)| time-filter SPNGFilterKernel, kind=highpass (scale~tau) |
| Wire (channel) filters            | HfFilter Wire_ind / Wire_col (sigma)    | channel decon SPNGFilterKernel, kind=lowpass (scale~sigma) |
| Response time offset (ctoffset)   | OmnibusSigProc.ctoffset                 | roll/crop options on SPNGKernelConvolve / decon_roll |

Notes:
- HfFilter `sigma`/LfFilter `tau` are in the same frequency units as SPNG
  filter_function `scale`; compare numerically. `power` maps directly.
- A `scale`/`sigma` or `power` mismatch is a genuine infidelity.
- Sign of SPNGResponseKernel.scale encodes convolution polarity; magnitude
  must equal official 1/lsb_voltage (== ADC_mV).
- Names in the official filter set are hard-coded and must be reproduced by an
  equivalent SPNG filter, even though SPNG does not reuse the names.
"""


def emit_prompt(name, wcsonnet, reference, keep=False):
    cmp_, off_spec, spng_jobs = resolve_comparison(name)
    off_graph = eval_official(off_spec, wcsonnet, reference, keep=keep)
    off_osp, off_filt = extract_osp(off_graph)
    tdm_graph = eval_spng(spng_jobs["tdm"], wcsonnet)
    tdm = extract_tdm(tdm_graph)

    filt_summary = {
        fname: info["data"] for fname, info in sorted(off_filt.items())
    }

    doc = []
    doc.append("# Faithfulness comparison: SPNG %s vs official %s (%s)"
               % (cmp_["spng"], cmp_["official"], name))
    doc.append("")
    doc.append("_%s_" % cmp_["desc"])
    doc.append("")
    doc.append(
        "You are auditing whether the SPNG-native (TDM) signal-processing "
        "configuration for **SPNG %s** faithfully reproduces the official "
        "dunereco OmnibusSigProc (OSP) configuration for **%s**. Below are "
        "machine-extracted, normalised parameters from both. Judge faithfulness, "
        "list any infidelities (missing/extra/mis-valued physics), and propose "
        "concrete Jsonnet edits under toolkit/spng/cfg/spng to bring SPNG into "
        "compliance. Ignore pure instance-name / runtime-context differences. "
        "Note: when the SPNG and official detectors differ (a cross comparison), "
        "the official side is chosen as the *nominal* design reference; call out "
        "any difference that is actually the official config's detector-specific "
        "quirk rather than an SPNG infidelity."
        % (cmp_["spng"], cmp_["official"])
    )
    doc.append("")
    doc.append(MAPPING_RUBRIC)
    doc.append("## Official OSP: OmnibusSigProc parameters (normalised)")
    doc.append("```json")
    doc.append(json.dumps(off_osp, indent=2, sort_keys=True))
    doc.append("```")
    doc.append("")
    doc.append("## Official OSP: filter components (name -> data)")
    doc.append("```json")
    doc.append(json.dumps(filt_summary, indent=2, sort_keys=True))
    doc.append("```")
    doc.append("")
    doc.append("## SPNG-native TDM nodes (physics-bearing data only)")
    doc.append("```json")
    doc.append(json.dumps(tdm, indent=2, sort_keys=True))
    doc.append("```")
    doc.append("")
    doc.append("## Your task")
    doc.append(
        "1. For each official filter and OSP parameter, find the SPNG-native "
        "equivalent using the rubric and state whether it matches.\n"
        "2. List infidelities as: `<what>` | official=`<val>` | spng=`<val>` | "
        "severity(high/med/low).\n"
        "3. Propose the minimal Jsonnet edit(s) (file + change) to fix each.\n"
        "4. Note any official element with no SPNG counterpart at all."
    )
    return "\n".join(doc)


